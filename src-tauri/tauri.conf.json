{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Elise",
  "version": "0.1.0",
  "identifier": "fr.jonathan.elise",
  "build": {
    "frontendDist": "../interfaces/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
            "label": "main",
            "title": "Élise",
            "url": "loading.html",
            "width": 800,
            "height": 600
        }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
